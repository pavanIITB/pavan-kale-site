<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or site.description }}">
  {% if sample %}<meta name="robots" content="noindex">{% endif %}
  <meta name="theme-color" content="#fffcf8">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
  <link rel="icon" href="{{ site.portrait | url }}" type="image/png">
  <link rel="apple-touch-icon" href="{{ site.portrait | url }}">
  {% if pagesOrigin and page.url != '/404.html' %}
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ pagesOrigin }}{{ page.url | url }}">
  <meta property="og:type" content="{% if section == 'blog' and page.url != '/blog/' %}article{% else %}website{% endif %}">
  <meta property="og:image" content="{{ pagesOrigin }}{{ site.portrait | url }}">
  <meta property="og:image:alt" content="{{ site.name }}">
  <meta name="twitter:card" content="summary">
  {% endif %}
  <link rel="stylesheet" href="{{ '/assets/site.css' | url }}?v=9">
  <link rel="stylesheet" href="{{ '/assets/palette.css' | url }}">
  {% if site.umamiWebsiteId and pagesHostname %}
  <script defer
    src="https://cloud.umami.is/script.js"
    data-website-id="{{ site.umamiWebsiteId }}"
    data-domains="{{ pagesHostname }}"
    data-do-not-track="true"
    data-exclude-hash="true"></script>
  {% endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header{% if page.url == '/' %} site-header-home{% endif %}">
    <div class="container site-header-inner">
      <a class="site-name" href="{{ '/' | url }}">
        {% if page.url != '/' %}
        <img src="{{ site.portrait | url }}" width="24" height="24" alt="">
        {% endif %}
        {{ site.name }}
      </a>
      <nav aria-label="Main navigation">
        <ul class="nav-list">
          <li><a href="{{ '/' | url }}"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a></li>
          <li><a href="{{ '/blog/' | url }}"{% if page.url == '/blog/' %} aria-current="page"{% elif section == 'blog' %} aria-current="location"{% endif %}>Blog</a></li>
          <li><a href="{{ '/schedule/' | url }}"{% if page.url == '/schedule/' %} aria-current="page"{% endif %}>Schedule a call</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main class="container site-main" id="main">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <span>{{ site.name }}</span>
      {% if site.links.length %}
      <ul class="link-list">
        {% for link in site.links %}
        <li><a href="{{ link.url }}">{{ link.label }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </footer>
</body>
</html>
