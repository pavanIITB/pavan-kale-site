---
layout: base.njk
---
<header class="intro">
  <div>
    <h1>{{ site.name }}</h1>
    <p class="lede">{{ intro }}</p>
  </div>
  <img class="portrait" src="{{ '/assets/pavan-kale.jpg' | url }}" width="800" height="800" alt="Pavan Kale">
</header>

<div class="prose">{{ content | safe }}</div>

<section class="page-section" id="writing" aria-labelledby="blog">
  <h2 id="blog">Blog</h2>
  {% set posts = collections.posts.slice(0, 3) %}
  {% if posts.length %}
    {% include "post-list.njk" %}
  {% elif site.linkedPosts.length %}
    {% include "linked-posts.njk" %}
  {% else %}
    <p class="muted">There are no published posts yet.</p>
  {% endif %}
  <a class="text-link archive-link" href="{{ '/blog/' | url }}">View all posts</a>
</section>
