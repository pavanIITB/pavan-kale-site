---
layout: base.njk
---
<header class="intro">
  <img class="portrait" src="{{ site.portrait | url }}" width="320" height="320" alt="{{ site.name }}">
  <div>
    <h1>{{ site.name }}</h1>
    <p class="lede">{{ intro }}</p>
  </div>
</header>

<div class="prose">
  {% set videoEmbed = videoUrl | youtubeEmbedUrl %}
  {% if videoEmbed %}
  <iframe
    class="home-video"
    src="{{ videoEmbed }}"
    title="{{ videoTitle or 'YouTube video' }}"
    width="560"
    height="315"
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allow="encrypted-media; picture-in-picture; fullscreen"
    allowfullscreen>
  </iframe>
  {% endif %}
  {{ content | safe }}
</div>

<section class="page-section" id="writing" aria-labelledby="blog">
  <h2 id="blog">Blog</h2>
  {% set posts = collections.posts.slice(0, 3) %}
  {% if posts.length %}
    {% include "post-list.njk" %}
  {% elif site.linkedPosts.length %}
    {% include "linked-posts.njk" %}
  {% else %}
    <p class="muted">There are no published posts yet.</p>
  {% endif %}
  <a class="text-link archive-link" href="{{ '/blog/' | url }}">View all posts</a>
</section>
