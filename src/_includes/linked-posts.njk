<ul class="post-list">
  {% for post in site.linkedPosts %}
  <li>
    <div>
      <p class="post-title"><a href="{{ post.url }}">{{ post.title }}</a></p>
      {% if post.description %}<p>{{ post.description }}</p>{% endif %}
    </div>
    <span class="post-source">{{ post.label }}</span>
  </li>
  {% endfor %}
</ul>
