---
layout: base.njk
---
<article class="article">
  <header class="page-heading">
    <a class="text-link back-link" href="{{ '/blog/' | url }}">All posts</a>
    <h1>{{ title }}</h1>
    {% if sample %}
    <p class="post-source post-date">Sample post</p>
    {% else %}
    <time class="muted post-date" datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
    {% endif %}
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
