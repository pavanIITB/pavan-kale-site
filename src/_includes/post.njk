---
layout: base.njk
---
<article class="article">
  <header class="page-heading">
    <a class="text-link back-link" href="{{ '/writing/' | url }}">All writing</a>
    <h1>{{ title }}</h1>
    <time class="muted" datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
