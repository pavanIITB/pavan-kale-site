---
layout: base.njk
title: Writing
description: Posts and essays by Pavan Kale.
---
<section class="page-heading" aria-labelledby="writing">
  <h1 id="writing">Writing</h1>
  <p class="lede">Notes on building products and running a company.</p>
</section>
{% set posts = collections.posts %}
{% if posts.length %}
<section class="page-section" aria-labelledby="posts">
  <h2 id="posts">Posts</h2>
  {% include "post-list.njk" %}
</section>
{% endif %}
{% if site.linkedWriting.length %}
<section class="page-section" aria-labelledby="elsewhere">
  <h2 id="elsewhere">Elsewhere</h2>
  {% include "linked-writing.njk" %}
</section>
{% elif not posts.length %}
<section class="page-section" aria-label="Posts">
  <p class="muted">There are no published posts yet.</p>
</section>
{% endif %}
